# NVIDIA NRAS evidence collector. Release this image beside attest-proxy and
# pin its immutable registry digest in confidential-infra/docker-compose.yml.
FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d
WORKDIR /app
COPY collector/gpu_evidence_collector.py /app/gpu_evidence_collector.py
# The collector API is pinned; release provenance records the resolved image
# digest. Never install packages at CVM startup.
RUN pip install --no-cache-dir --disable-pip-version-check nv-attestation-sdk==2.7.3 \
    && mkdir -p /evidence \
    && chown 65532:65532 /evidence
USER 65532:65532
ENTRYPOINT ["python", "/app/gpu_evidence_collector.py"]
