# syntax=docker/dockerfile:1
FROM golang:1.26-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS build
WORKDIR /src
COPY go.mod ./
COPY cmd/model-measurer/ cmd/model-measurer/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/model-measurer ./cmd/model-measurer
RUN mkdir -p /out/model-evidence && chown 65532:65532 /out/model-evidence

FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /out/model-measurer /model-measurer
COPY --from=build --chown=65532:65532 /out/model-evidence /model-evidence
USER nonroot
ENTRYPOINT ["/model-measurer"]
